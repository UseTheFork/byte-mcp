{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "sortImports": true,
  "sortTailwindcss": true,
  "sortPackageJson": true,
  "trailingComma": "all",
  "ignorePatterns": [
    "**/dist/**",
    "**/build/**",
    "**/.turbo/**",
    "**/chart/**",
    "**/vendor/**",
    "**/result/**"
  ]
}
